# Ignore Python local cache across repo
**/__pycache__/

# Debug session artifacts
debug-session/

# Ignore BuildStream local state
.bst
.bst2
.cache/*

*.img
*.raw
*.tar
.ovmf-vars.fd
.build-out
.build-ownership/
.build-ownership-source/

# Local AI agent state (opencode sessions, drafts)
# Skills are committed; everything else is ignored
.opencode/*
!.opencode/skills/

# Git worktrees
.worktrees/
files/xattr-db/
files/fakecap/fakecap-restore
files/fakecap/fakecap.so

# Secure Boot signing key, written by publish CI or just secure-boot-keygen
files/boot-keys/private/*
!files/boot-keys/private/.keep
