[Unit]
Description=Incus - Main daemon
Documentation=https://linuxcontainers.org/incus/docs/main/
After=network-online.target incus.socket
Requires=network-online.target incus.socket

[Service]
Delegate=yes
EnvironmentFile=-/etc/default/incus
Environment="PATH=/usr/libexec/incus:/usr/bin:/usr/sbin:/bin"
ExecStart=/usr/libexec/incus/incusd --group incus-admin
ExecStartPost=/usr/libexec/incus/incusd waitready --timeout=600
KillMode=process
TimeoutStartSec=600s
TimeoutStopSec=30s
Restart=on-failure
LimitNOFILE=1048576
LimitNPROC=infinity
TasksMax=infinity
OOMScoreAdjust=-1000

[Install]
Also=incus.socket
