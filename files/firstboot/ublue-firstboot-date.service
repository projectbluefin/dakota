[Unit]
Description=Record Dakota first-boot installation date
After=local-fs.target

# Started by ublue-firstboot-date.path, never directly at boot: the date is
# only trustworthy after the clock has been synchronized. The script leaves a
# sane record alone, so running on every boot is a no-op. RemainAfterExit
# keeps the unit active so the path unit does not start it again.
[Service]
Type=oneshot
ExecStart=/usr/bin/ublue-firstboot-date
RemainAfterExit=yes
