[Transfer]
ProtectVersion=%A
Features=bluefin

[Source]
Type=url-file
Path=https://dl.projectbluefin.io/sysupdate/
MatchPattern=bluefin-%a_@v.raw \
             bluefin-%a_@v.raw.xz \
             bluefin-%a_@v.raw.zst

[Target]
Type=regular-file
Path=/var/lib/extensions/
MatchPattern=bluefin_@v.raw
InstancesMax=2
