# Generated by build-aux/install-libfinupdate.sh.
# Lets a downstream gnome-control-center build that vendors cc-panel/
# discover libfinupdate.so + finupdate.h via `pkg-config --libs libfinupdate`.

prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: libfinupdate
Description: Backend for the gnome-control-center Updates panel
Version: @VERSION@
Libs: -L${libdir} -lfinupdate
Cflags: -I${includedir}
