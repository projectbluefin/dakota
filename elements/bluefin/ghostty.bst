config:
  build-commands:
    # Populate the Zig package cache offline. `zig fetch <archive>` caches a
    # local tarball without stripping its top-level directory, so the package
    # fails its hash check at build time; unpack it the way Zig's own fetcher
    # does (strip a lone top-level directory) and fetch the directory instead.
    - |
      export ZIG_GLOBAL_CACHE_DIR="/tmp/zig-cache"
      export ZIG_LIB_DIR="%{libdir}/zig"
      for archive in zig-deps/*; do
        unpacked="$(mktemp -d)"
        case "$archive" in
          *.zst) zstd -qdc "$archive" | tar -x --no-same-owner -C "$unpacked" ;;
          *) tar -xf "$archive" --no-same-owner -C "$unpacked" ;;
        esac
        package="$unpacked"
        entries="$(ls -A "$unpacked")"
        if [ "$(printf '%s\n' "$entries" | wc -l)" -eq 1 ] && [ -d "$unpacked/$entries" ]; then
          package="$unpacked/$entries"
        fi
        hash="$(zig fetch "$package")"
        echo "Fetched $archive as $hash"
        rm -rf "$unpacked"
      done

  install-commands:
    - |
      export ZIG_GLOBAL_CACHE_DIR="/tmp/zig-cache"
      export ZIG_LIB_DIR="%{libdir}/zig"
      # Zig's bundled glibc stubs can lag the fdsdk glibc, leaving libs
      # referencing symbols the stubs lack. Point zig at the real system
      # libc instead of its stubs; cc_dir holds GCC's crtbegin/crtend.
      cat > /tmp/system-libc.conf <<LIBC
      include_dir=/usr/include
      sys_include_dir=$(ls -d /usr/include/*-linux-gnu 2>/dev/null | head -n1 || echo /usr/include)
      crt_dir=%{libdir}
      msvc_lib_dir=
      kernel32_lib_dir=
      cc_dir=$(dirname "$(gcc -print-file-name=crtbeginS.o)")
      darwin_sdk_dir=
      LIBC
      sed -i 's/^      //' /tmp/system-libc.conf
      DESTDIR="%{install-root}" \
      zig build \
        --libc /tmp/system-libc.conf \
        --prefix /usr \
        -Doptimize=ReleaseFast \
        -Dcpu=baseline \
        -Dpie=true \
        -Demit-docs=false \
        -Dversion-string=1.4.0
