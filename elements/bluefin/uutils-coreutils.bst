kind: make

config:
  build-commands:
  - cargo build --release --features feat_os_unix --no-default-features

  install-commands:
  - install -Dm755 target/release/coreutils "%{install-root}/usr/bin/uutils-coreutils"
  - |
    for prog in $(target/release/coreutils --list); do
      ln -sr "%{install-root}/usr/bin/uutils-coreutils" "%{install-root}/usr/bin/uutils-${prog}"
      # Keep cp/mv/rm from GNU coreutils — uutils has unresolved TOCTOU issues.
      # See projectbluefin/common#290.
      case "${prog}" in
        cp|mv|rm) continue ;;
      esac
      ln -sr "%{install-root}/usr/bin/uutils-coreutils" "%{install-root}/usr/bin/${prog}"
    done

public:
  bst:
    overlap-whitelist:
    - /usr/bin/[
    - /usr/bin/arch
    - /usr/bin/b2sum
    - /usr/bin/base32
    - /usr/bin/base64
    - /usr/bin/basename
    - /usr/bin/basenc
    - /usr/bin/cat
    - /usr/bin/chgrp
    - /usr/bin/chmod
    - /usr/bin/chown
    - /usr/bin/chroot
