kind: manual

build-depends:
- freedesktop-sdk.bst:components/rust.bst
- freedesktop-sdk.bst:components/cmake.bst
- freedesktop-sdk.bst:public-stacks/buildsystem-make.bst

depends:
- freedesktop-sdk.bst:public-stacks/runtime-minimal.bst
- freedesktop-sdk.bst:components/systemd.bst
- freedesktop-sdk.bst:components/iproute2.bst
- freedesktop-sdk.bst:components/nftables.bst

config:
  build-commands:
  - cargo build --release --offline

  # Completions and the man page come from the binary's own clap
  # definition, as upstream's Arch and Fedora packaging does. The daemon
  # is D-Bus activated and creates /var/lib/nspawn itself, so no unit is
  # enabled and no /var content ships. The wheel polkit rule is an
  # upstream example that grants root-equivalent access; it is not
  # installed.
  install-commands:
  - install -Dm755 target/release/nspawn "%{install-root}%{bindir}/nspawn"
  - |
    for shell in bash zsh fish; do
      target/release/nspawn completions "${shell}" > "nspawn.${shell}"
    done
    target/release/nspawn manpage > nspawn.1
  - install -Dm644 nspawn.bash "%{install-root}%{datadir}/bash-completion/completions/nspawn"
  - install -Dm644 nspawn.zsh "%{install-root}%{datadir}/zsh/site-functions/_nspawn"
  - install -Dm644 nspawn.fish "%{install-root}%{datadir}/fish/vendor_completions.d/nspawn.fish"
  - install -Dm644 nspawn.1 "%{install-root}%{mandir}/man1/nspawn.1"
  - install -Dm644 packaging/systemd/nspawn.service "%{install-root}%{indep-libdir}/systemd/system/nspawn.service"
  - install -Dm644 packaging/dbus/org.nspawn.service "%{install-root}%{datadir}/dbus-1/system-services/org.nspawn.service"
  - install -Dm644 packaging/dbus/org.nspawn.conf "%{install-root}%{datadir}/dbus-1/system.d/org.nspawn.conf"
  - install -Dm644 packaging/polkit/org.nspawn.policy "%{install-root}%{datadir}/polkit-1/actions/org.nspawn.policy"
  - '%{install-extra}'

